# Optimized variant of test-cases/infra/container-image/Dockerfile
# - slim base image, no build tools or editors, no dev tools in the production image
# - requirements installed before the source is copied, so the dependency layer is cached
# - no pip cache in the image, runs as unprivileged user
# (No BuildKit cache mounts: GMT builds with kaniko, which doesn't support RUN --mount.)
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .

USER nobody
EXPOSE 8000

CMD ["gunicorn", "-b", "0.0.0.0:8000", "app:app"]
